# Gasdelivery.nl — static site (Apache fallback config; Vercel uses vercel.json)
Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset utf-8
AddType image/avif .avif
AddType image/webp .webp
AddType application/manifest+json .webmanifest

RewriteEngine On

# One canonical host: https + non-www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.gasdelivery\.nl$ [NC]
RewriteRule ^(.*)$ https://gasdelivery.nl/$1 [L,R=301]

# Old Next.js URLs (extensionless) -> current .html pages (301, keeps link equity)
RewriteRule ^faq/?$ /faq.html [L,R=301]
RewriteRule ^privacy/?$ /privacy.html [L,R=301]
RewriteRule ^voorwaarden/?$ /voorwaarden.html [L,R=301]
RewriteRule ^lachgas-bestellen/([a-z-]+)/?$ /lachgas-bestellen/$1.html [L,R=301]
RewriteRule ^lachgas-informatie/([a-z0-9-]+)/?$ /lachgas-informatie/$1.html [L,R=301]
RewriteRule ^opengraph-image/?$ /images/opengraph-image.png [L,R=301]
RewriteRule ^twitter-image/?$ /images/twitter-image.png [L,R=301]
RewriteRule ^icon/?$ /images/icon.png [L,R=301]
RewriteRule ^apple-icon/?$ /images/apple-icon.png [L,R=301]

# Any other extensionless request that matches an .html file -> serve it (no redirect)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.html

# Compression
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# Caching: images/css/js long-lived (file names change when content changes), HTML always revalidated
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|png|jpe?g|svg|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security headers (audited against what the site loads: self-hosted CSS/JS/images,
  # one identical inline <script> on every page (hash below), inline <style> + style attributes,
  # wa.me / tel: / mailto: navigations, contact form posting to Formspree).
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-PSlDg8dRMzi9mxb3lJBly2miCeGfg6WRGGVXdxnas8k='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>
